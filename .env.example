# Copy to .env.dev for local work, and set the same variable in Netlify.
# Free key: https://api.setlist.fm/docs/1.0/index.html
SETLISTFM_API_KEY=

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Set it in Netlify; it's read at build time.
# Analytics never run on localhost or deploy previews, so it isn't needed in .env.dev.
PUBLIC_GA_ID=
