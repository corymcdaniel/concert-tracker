<!-- Asks once before any analytics load (analytics.js). Hidden until it's needed, and only on the live site. -->
<div class="consent" id="consent" role="region" aria-label="Analytics" hidden>
  <p class="consent-k">Mind if I count visits?</p>
  <p class="consent-p">Google Analytics, so I can see which stats and shows people look at. No ads, no tracking across other sites.</p>
  <div class="consent-actions">
    <button type="button" class="primary" id="consentAllow">Allow</button>
    <button type="button" id="consentDeny">No thanks</button>
  </div>
</div>
