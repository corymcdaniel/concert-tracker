<div id="logView" class="sv">
  <div class="filters">
    <input type="search" id="q" placeholder="Search artist, venue, city…" aria-label="Search">
    <div class="seg" role="group" aria-label="Type">
      <button type="button" data-type="" aria-pressed="true">All</button>
      <button type="button" data-type="Music" aria-pressed="false">Music</button>
      <button type="button" data-type="Comedy" aria-pressed="false">Comedy</button>
    </div>
    <select id="city" aria-label="City"><option value="">All cities</option></select>
  </div>

  <main id="list" class="list" aria-busy="true">
    <!-- Shown until the shows load: a hand of blank tickets that deals out into the real ones (log.js dealIn) -->
    <div class="deck" id="deck" role="status">
      <span class="sr-only">Loading the log…</span>
      <div class="ghost g1"><i class="gd"></i><i class="gb"><b></b><b></b><b></b></i></div>
      <div class="ghost g2"><i class="gd"></i><i class="gb"><b></b><b></b><b></b></i></div>
      <div class="ghost g3"><i class="gd"></i><i class="gb"><b></b><b></b><b></b></i></div>
      <div class="ghost g4"><i class="gd"></i><i class="gb"><b></b><b></b><b></b></i></div>
      <div class="ghost g5"><i class="gd"></i><i class="gb"><b></b><b></b><b></b></i></div>
    </div>
  </main>
  <section class="endcap" id="endcap" aria-label="End of the log"></section>
</div>
